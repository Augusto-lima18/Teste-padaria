<!DOCTYPE html>
<html lang="pt-BR" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- Meta tags de segurança e otimização -->
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="referrer" content="strict-origin-when-cross-origin">
    <title>Sua Padaria & Café | Tradição e Sabor</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#f4f7f5',
                            100: '#e3eae6',
                            500: '#4d6a5d',
                            600: '#3f574c',
                            700: '#32453c',
                        }
                    }
                }
            }
        }
    </script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-stone-50 text-stone-800 font-sans antialiased selection:bg-brand-500 selection:text-white">

    <!-- BOTÃO FLUTUANTE DO WHATSAPP -->
    <a href="https://wa.me/5519999999999?text=Olá!%20Gostaria%20de%20tirar%20uma%20dúvida." 
       target="_blank" 
       rel="noopener noreferrer"
       aria-label="Falar pelo WhatsApp"
       class="fixed bottom-5 right-5 z-50 bg-emerald-600 hover:bg-emerald-700 text-white p-4 rounded-full shadow-2xl transition-all hover:scale-110 flex items-center justify-center border border-emerald-400/30">
        <i data-lucide="message-circle" class="w-7 h-7"></i>
    </a>

    <!-- CABEÇALHO / NAVBAR -->
    <header class="sticky top-0 z-40 bg-stone-50/90 backdrop-blur-md border-b border-stone-200">
        <div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
            <div class="flex items-center gap-3">
                <div class="w-12 h-12 bg-stone-200 border-2 border-dashed border-stone-400 rounded-lg flex items-center justify-center text-stone-500 text-xs font-semibold">
                    LOGO
                </div>
                <span class="font-semibold text-stone-700 tracking-tight text-sm hidden sm:inline">Sua Padaria</span>
            </div>

            <a href="#contato" class="bg-brand-500 hover:bg-brand-600 text-white px-4 py-2 rounded-xl text-sm font-medium transition-all shadow-sm">
                Falar Conosco
            </a>
        </div>
    </header>

    <!-- HERO SECTION (TOPO) -->
    <section class="relative py-16 md:py-24 px-4 max-w-6xl mx-auto text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-12">
        <div class="md:w-1/2 space-y-6">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-brand-100 border border-brand-500/20 text-brand-700 text-xs font-semibold tracking-wide uppercase">
                <i data-lucide="coffee" class="w-4 h-4"></i> Seu café da manhã perfeito é aqui
            </div>
            <h1 class="text-4xl md:text-5xl font-serif font-bold text-stone-900 tracking-tight leading-tight">
                Pães artesanais, cafés especiais e <span class="text-brand-500">momentos inesquecíveis.</span>
            </h1>
            <p class="text-stone-600 text-base md:text-lg leading-relaxed">
                Tudo feito com carinho todos os dias para trazer o verdadeiro sabor da tradição para a sua mesa.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 pt-2">
                <a href="#cardapio" class="bg-brand-500 hover:bg-brand-600 text-white font-semibold px-6 py-3.5 rounded-xl text-center shadow-lg shadow-brand-500/20 transition-all flex items-center justify-center gap-2">
                    <i data-lucide="book-open"></i> Ver Cardápio
                </a>
                <a href="#sobre" class="bg-stone-200 hover:bg-stone-300 text-stone-800 font-semibold px-6 py-3.5 rounded-xl text-center transition-all">
                    Nossa História
                </a>
            </div>
        </div>

        <div class="md:w-1/2 w-full">
            <div class="relative mx-auto max-w-md rounded-2xl overflow-hidden shadow-xl border border-stone-200 bg-white p-2">
                <img src="https://images.unsplash.com/photo-1509440159596-0249088772ff?auto=format&fit=crop&w=800&q=80" 
                     alt="Pães e Café Artesanal" 
                     loading="lazy"
                     class="rounded-xl object-cover w-full h-72 md:h-96">
            </div>
        </div>
    </section>

    <!-- SEÇÃO CARDÁPIO -->
    <section id="cardapio" class="py-16 md:py-20 bg-stone-100 border-y border-stone-200 px-4">
        <div class="max-w-4xl mx-auto text-center space-y-6">
            <div class="w-12 h-12 bg-brand-500/10 text-brand-500 rounded-full flex items-center justify-center mx-auto">
                <i data-lucide="utensils" class="w-6 h-6"></i>
            </div>
            <h2 class="text-3xl font-serif font-bold text-stone-900">Nosso Cardápio</h2>
            <p class="text-stone-600 max-w-xl mx-auto">
                Confira nossas opções de pães frescos, cafés passados na hora, salgados artesanais e doces especiais.
            </p>
            <div class="pt-2">
                <a href="https://wa.me/5519999999999?text=Olá!%20Gostaria%20de%20ver%20o%20cardápio%20completo." 
                   target="_blank" 
                   rel="noopener noreferrer"
                   class="inline-flex items-center gap-3 bg-brand-500 hover:bg-brand-600 text-white font-bold px-8 py-4 rounded-xl text-lg transition-all shadow-md">
                    <i data-lucide="file-text" class="w-5 h-5"></i>
                    Acessar Cardápio Completo
                </a>
            </div>
        </div>
    </section>

    <!-- SEÇÃO SOBRE -->
    <section id="sobre" class="py-16 md:py-20 px-4 max-w-4xl mx-auto text-center">
        <div class="space-y-6">
            <div class="w-12 h-12 bg-brand-500/10 text-brand-500 rounded-full flex items-center justify-center mx-auto">
                <i data-lucide="heart" class="w-6 h-6"></i>
            </div>
            <h2 class="text-3xl font-serif font-bold text-stone-900">Nossa História</h2>
            <p class="text-stone-600 max-w-xl mx-auto">
                Conheça a trajetória, os valores e o amor pela panificação que tornam a nossa casa um ponto de encontro especial.
            </p>
            <div class="pt-2">
                <a href="https://wa.me/5519999999999?text=Olá!%20Quero%20saber%20mais%20sobre%20a%20história%20da%20padaria." 
                   target="_blank" 
                   rel="noopener noreferrer"
                   class="inline-flex items-center gap-2 bg-stone-200 hover:bg-stone-300 text-stone-800 font-semibold px-8 py-3.5 rounded-xl transition-all">
                    <i data-lucide="arrow-right" class="w-4 h-4"></i>
                    Conhecer Mais
                </a>
            </div>
        </div>
    </section>

    <!-- LOCALIZAÇÃO E HORÁRIOS -->
    <section id="contato" class="py-16 px-4 bg-brand-500 text-white">
        <div class="max-w-5xl mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 items-center">
            <div class="space-y-4 text-center md:text-left">
                <h2 class="text-3xl font-serif font-bold">Venha nos visitar!</h2>
                <p class="text-brand-100 text-sm leading-relaxed">
                    Aberto todos os dias para deixar o seu dia mais gostoso.
                </p>
                <div class="space-y-3 pt-2">
                    <div class="flex items-center justify-center md:justify-start gap-3 text-brand-100">
                        <i data-lucide="map-pin" class="w-5 h-5 text-white"></i>
                        <span>Campinas - SP</span>
                    </div>
                    <div class="flex items-center justify-center md:justify-start gap-3 text-brand-100">
                        <i data-lucide="clock" class="w-5 h-5 text-white"></i>
                        <span>Segunda a Domingo: 06h às 20h</span>
                    </div>
                </div>
            </div>

            <div class="bg-white/10 backdrop-blur-md p-6 rounded-2xl border border-white/20 text-center space-y-4">
                <h3 class="font-semibold text-lg">Dúvidas ou Encomendas?</h3>
                <p class="text-sm text-brand-100">Entre em contato direto com a nossa equipe no balcão.</p>
                <a href="https://wa.me/5519999999999" 
                   target="_blank" 
                   rel="noopener noreferrer"
                   class="block w-full bg-white text-brand-700 hover:bg-brand-50 font-bold py-3.5 rounded-xl transition-all shadow-md">
                    Chamar no WhatsApp
                </a>
            </div>
        </div>
    </section>

    <!-- RODAPÉ -->
    <footer class="py-8 bg-stone-900 text-stone-400 text-xs text-center">
        <p>© 2026 Padaria & Café. Todos os direitos reservados.</p>
        <p class="mt-1">Desenvolvido por <span class="text-stone-200 font-semibold">Menterea</span></p>
    </footer>

    <!-- INICIALIZAÇÃO DOS ÍCONES LUCIDE -->
    <script>
        lucide.createIcons();
    </script>
</body>
</html>
